{
	email {$ACME_EMAIL}
}

# Cabeçalhos e compressão comuns a todos os hosts
(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# SPA React: rotas desconhecidas caem no index.html
(spa) {
	root * /srv/frontend

	@assets path /assets/*
	@notassets not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @notassets Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Domínio principal: site comercial do sistema (sem API e sem loja)
{$DOMAIN} {
	import common
	redir / /triunfo-menu 302
	import spa
}

# Lojas: um host por loja até o TLS sob demanda ser configurado.
# O Host da requisição chega intacto ao PHP, que resolve a loja pelo domínio.
rafalanches.{$DOMAIN} {
	import common

	handle /api/* {
		root * /var/www/html/public
		php_fastcgi app:9000
	}

	handle {
		import spa
	}
}
