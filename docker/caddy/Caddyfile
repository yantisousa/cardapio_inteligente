{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Um host por loja até o TLS sob demanda ser configurado
{$DOMAIN}, rafalanches.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API Laravel. O Host da requisição chega intacto ao PHP, que resolve a loja pelo domínio.
	handle /api/* {
		root * /var/www/html/public
		php_fastcgi app:9000
	}

	# SPA React: /admin, /triunfo-menu e demais rotas caem no index.html
	handle {
		root * /srv/frontend

		@assets path /assets/*
		@notassets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @notassets Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
